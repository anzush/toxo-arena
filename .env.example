# Copia este archivo a .env.local y completa con los datos de tu proyecto
# de Firebase (Configuración del proyecto > Tus apps > Config del SDK).
# Necesitas crear una Realtime Database (no Firestore) en modo de prueba.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
